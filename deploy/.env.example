# Copy to deploy/.env and fill in. Never commit deploy/.env.
# Generate secrets with:  openssl rand -hex 32      (hex avoids URL-encoding issues in DATABASE_URL)
# ENCRYPTION_KEY must be exactly 32 random bytes, base64:  openssl rand -base64 32

# --- required -------------------------------------------------------------------------
POSTGRES_PASSWORD=
SECRET_KEY=
ENCRYPTION_KEY=
OTLP_INGEST_TOKEN=
METRICS_SCRAPE_TOKEN=

# --- first start only: creates the first admin when no users exist; remove afterwards ---
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=

# --- application ------------------------------------------------------------------------
APP_ENV=development
PUBLIC_BASE_URL=http://localhost:3000
# Public OTLP endpoint shown in onboarding snippets (what monitored apps should use)
OTLP_PUBLIC_ENDPOINT=http://localhost:4318
LOG_LEVEL=INFO
API_DOCS_ENABLED=true

# --- monitoring & alerting ------------------------------------------------------------------
ALERT_EVAL_INTERVAL_SECONDS=30
TARGET_STALE_AFTER_SECONDS=300
ENABLE_MONITORING_LOOP=true
NOTIFICATION_COOLDOWN_SECONDS=300
ALLOW_PRIVATE_WEBHOOKS=false
PROMETHEUS_RETENTION=15d

# --- jobs & scanning --------------------------------------------------------------------------
WORKER_CONCURRENCY=2
JOB_LEASE_SECONDS=1200
SCAN_TIMEOUT_SECONDS=900
CLONE_MAX_MB=200
SEMGREP_RULES=bundled
TRIVY_SKIP_DB_UPDATE=false
SCHEDULED_SCAN_INTERVAL_HOURS=0

# --- AI (optional) ----------------------------------------------------------------------------
AI_ENABLED=false
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
AI_DAILY_REQUEST_CAP=50
AI_MAX_INPUT_TOKENS=12000
AI_MAX_OUTPUT_TOKENS=2000

# --- remediation (optional; start with --profile remediation) ---------------------------------
REMEDIATION_ENABLED=false
SANDBOX_DOCKER_HOST=tcp://sandbox-docker:2375

# --- demo app (optional; --profile demo) --------------------------------------------------------
DEMO_ADMIN_TOKEN=

# --- host bind addresses (keep 127.0.0.1 unless a TLS reverse proxy is in front) ----------------
API_BIND=127.0.0.1
WEB_BIND=127.0.0.1
OTLP_BIND=127.0.0.1
